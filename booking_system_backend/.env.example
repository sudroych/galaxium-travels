# Email Configuration
# Set EMAIL_ENABLED=true to send actual emails via SMTP
# Set EMAIL_ENABLED=false (or omit) to log emails to console (development mode)
EMAIL_ENABLED=false

# SMTP Configuration (required only if EMAIL_ENABLED=true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@galaxiumtravels.com

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use the app password as SMTP_PASSWORD